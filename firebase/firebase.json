{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/ai", "function": { "functionId": "ai", "region": "asia-east1" } }
    ],
    "headers": [
      { "source": "stories.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }]
}
